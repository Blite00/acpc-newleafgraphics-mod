static void pc_donor_ambient_color(unsigned char out[3],int now,float wet) {
    int h,n,s,c;
    now%=86400; if(now<0)now+=86400;
    h=now/3600;n=(h+1)%24;s=now%3600;
    if(wet<0.0f)wet=0.0f;if(wet>1.0f)wet=1.0f;
    for(c=0;c<3;++c) {
        float dry=(pc_donor_ambient_palettes[0][h][c]*(3600-s)+pc_donor_ambient_palettes[0][n][c]*s)/3600.0f;
        float rain=(pc_donor_ambient_palettes[2][h][c]*(3600-s)+pc_donor_ambient_palettes[2][n][c]*s)/3600.0f;
        out[c]=(unsigned char)(dry+(rain-dry)*wet);
    }
}
