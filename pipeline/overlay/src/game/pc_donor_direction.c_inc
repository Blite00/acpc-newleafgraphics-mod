static void pc_donor_trig(unsigned angle, float* s, float* c) {
    const float* row=pc_donor_sincos[(angle & 65535u)>>8];
    float t=(float)(angle & 255u)*(1.0f/256.0f);
    *s=row[0]+row[2]*t; *c=row[1]+row[3]*t;
}
static void pc_donor_daily_light_vector(float out[3], int seconds_since_midnight,
                                        int actor_light, int reference_roll) {
    static const int angles[4]={-12000,-12000,-7868,-12000};
    int seconds=seconds_since_midnight%86400;
    int angle, sector;
    unsigned day_angle;
    float s,c,x,y,z,t,length;
    if(seconds<0)seconds+=86400;
    sector=seconds/21600;
    angle=actor_light ? -5461 : (int)((float)angles[sector]
        +(float)(angles[(sector+1)&3]-angles[sector])
        *((float)(seconds%21600)*(1.0f/21600.0f)));
    day_angle=(unsigned)((float)seconds*(1.0f/86400.0f)*65536.0f);
    pc_donor_trig((unsigned)angle,&s,&c);
    x=0.0f; y=c; z=s;
    pc_donor_trig(day_angle,&s,&c);
    x=s*z; z=c*z;
    pc_donor_trig((unsigned)(32768+reference_roll),&s,&c);
    t=c*y-s*z; z=s*y+c*z; y=t;
    length=sqrtf(x*x+y*y+z*z);
    out[0]=-x/length; out[1]=-y/length; out[2]=-z/length;
}
